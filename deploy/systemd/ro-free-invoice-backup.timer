[Unit]
Description=Daily ro-free-invoice backup at 03:30 Europe/Bucharest

[Timer]
# The zone is written out, whatever the host's timezone is.
OnCalendar=*-*-* 03:30:00 Europe/Bucharest
# A run missed while the host was down happens at the next boot, so that backup's
# short downtime of app can then happen outside 03:30.
Persistent=true
Unit=ro-free-invoice-backup.service

[Install]
WantedBy=timers.target
